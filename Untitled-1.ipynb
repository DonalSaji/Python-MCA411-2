# %%
import pandas as pd
import matplotlib.pyplot as plt
iris = pd.read_csv("C:\\Users\\ASUS\\Documents\\python\\iris.csv")
iris.head()

# %%
iris['Species'].unique()

# %%
print(iris.groupby('Species').size())
print(iris.groupby('Species').min())



# %%
Setosa=iris[iris['Species']=='Iris-setosa']
versicolor=iris[iris['Species']=='Iris-versicolor']
viriginica=iris[iris['Species']=='Iris-virginica']

# %%
Setosa['SepalWidth'].mean()


# %%
data=Setosa['SepalWidth']
data.plot(kind='hist', label='Setosa', color='r', fontsize=10)
plt.title('Setosa SepalWidth - Histogram')
plt.xlabel('SepalWidthCm')
plt.show()

# %%
Setosa.plot(x='SepalLength', y='SepalWidth', kind='scatter', color='r', label='Setosa')
plt.title('scatter plot -setosa')
plt.xlabel('SepalLengthCm')
plt.ylabel('SepalLengthCm')
plt.show()